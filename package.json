{
  "name": "synapse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "tsx apps/server/src/main.ts",
    "build": "pnpm typecheck && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages scripts e2e",
    "format": "prettier --write apps packages scripts e2e",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:real-vault": "tsx apps/server/scripts/verify-real-vault.ts",
    "fixtures:private": "node scripts/prepare-private-fixtures.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "@eslint/js": "^9",
    "typescript-eslint": "^8",
    "prettier": "^3",
    "tsx": "^4",
    "vitest": "^3.2.6",
    "@vitest/coverage-v8": "^3.2.6",
    "@playwright/test": "^1.60",
    "fast-check": "^4",
    "vite": "^6.4.1",
    "@vitejs/plugin-react": "^4.7"
  }
}
